{
  "_": "Canonical behaviour of the playback-sync decision core. See ./README.md. Edited in one language only, this file fails the other language's suite.",

  "constants": {
    "TICKS": 10000000,
    "CONTROL_MS": 200,
    "HARD_SEEK_SEC": 1.0,
    "HOST_DRAG_SEEK_SEC": 2.0,
    "SOFT_SEC": 0.08,
    "SOFT_EXIT_SEC": 0.04,
    "RATE_GAIN": 0.12,
    "MAX_RATE_ADJ": 0.08,
    "HOLD_TOLERANCE": 0.4,
    "HARD_SEEK_COOLDOWN_MS": 2500
  },

  "predictPosition": [
    {
      "name": "no schedule predicts the origin",
      "schedule": null,
      "serverNowMs": 12345,
      "expect": 0
    },
    {
      "name": "while playing the timeline advances at wall rate from t0",
      "schedule": { "positionTicks": 500000000, "t0": 1000, "rate": 1, "paused": false, "phase": "playing", "version": 3, "mediaGeneration": 1 },
      "serverNowMs": 3000,
      "expect": 52
    },
    {
      "name": "a paused timeline is frozen at P0 regardless of the clock",
      "schedule": { "positionTicks": 500000000, "t0": 1000, "rate": 0, "paused": true, "phase": "paused", "version": 3, "mediaGeneration": 1 },
      "serverNowMs": 999999,
      "expect": 50
    },
    {
      "name": "a stalled timeline is frozen exactly like a paused one",
      "schedule": { "positionTicks": 500000000, "t0": 1000, "rate": 0, "paused": false, "phase": "stalled", "version": 3, "mediaGeneration": 1 },
      "serverNowMs": 999999,
      "expect": 50
    }
  ],

  "decideSyncAction": [
    {
      "name": "no schedule is a no-op",
      "schedule": null,
      "serverNowMs": 3000,
      "clockReady": true,
      "currentTime": 10,
      "paused": false,
      "isHost": false,
      "mode": "hopping",
      "userSeeking": false,
      "suppressHardSeek": false,
      "correctionState": null,
      "expect": null
    },
    {
      "name": "a hopping host plays natively and never runs the correction loop",
      "schedule": { "positionTicks": 500000000, "t0": 1000, "rate": 1, "paused": false, "phase": "playing", "version": 3, "mediaGeneration": 1 },
      "serverNowMs": 3000,
      "clockReady": true,
      "currentTime": 10,
      "paused": false,
      "isHost": true,
      "mode": "hopping",
      "userSeeking": false,
      "suppressHardSeek": false,
      "correctionState": null,
      "expect": null
    },
    {
      "name": "a member actively scrubbing is left alone",
      "schedule": { "positionTicks": 500000000, "t0": 1000, "rate": 1, "paused": false, "phase": "playing", "version": 3, "mediaGeneration": 1 },
      "serverNowMs": 3000,
      "clockReady": true,
      "currentTime": 10,
      "paused": false,
      "isHost": false,
      "mode": "hopping",
      "userSeeking": true,
      "suppressHardSeek": false,
      "correctionState": null,
      "expect": null
    },
    {
      "name": "paused phase pauses a still-playing member on the frozen frame",
      "schedule": { "positionTicks": 1000000000, "t0": 0, "rate": 0, "paused": true, "phase": "paused", "version": 7, "mediaGeneration": 2 },
      "serverNowMs": 50000,
      "clockReady": true,
      "currentTime": 100.2,
      "paused": false,
      "isHost": false,
      "mode": "hopping",
      "userSeeking": false,
      "suppressHardSeek": false,
      "correctionState": null,
      "expect": { "seekTo": null, "rate": 1, "play": false, "pause": true, "hardSeek": false, "pausedSeek": false, "drift": null }
    },
    {
      "name": "a paused member off the frozen frame takes the buffer-aware paused seek",
      "schedule": { "positionTicks": 1000000000, "t0": 0, "rate": 0, "paused": true, "phase": "paused", "version": 7, "mediaGeneration": 2 },
      "serverNowMs": 50000,
      "clockReady": true,
      "currentTime": 95,
      "paused": true,
      "isHost": false,
      "mode": "hopping",
      "userSeeking": false,
      "suppressHardSeek": false,
      "correctionState": null,
      "expect": { "seekTo": 100, "rate": 1, "play": false, "pause": false, "hardSeek": false, "pausedSeek": true, "drift": null }
    },
    {
      "name": "drift inside HOLD_TOLERANCE does not re-seek a held member",
      "schedule": { "positionTicks": 1000000000, "t0": 0, "rate": 0, "paused": true, "phase": "paused", "version": 7, "mediaGeneration": 2 },
      "serverNowMs": 50000,
      "clockReady": true,
      "currentTime": 100.35,
      "paused": true,
      "isHost": false,
      "mode": "hopping",
      "userSeeking": false,
      "suppressHardSeek": false,
      "correctionState": null,
      "expect": { "seekTo": null, "rate": 1, "play": false, "pause": false, "hardSeek": false, "pausedSeek": false, "drift": null }
    },
    {
      "name": "stalled phase freezes the room exactly like paused",
      "schedule": { "positionTicks": 1000000000, "t0": 0, "rate": 0, "paused": false, "phase": "stalled", "version": 7, "mediaGeneration": 2 },
      "serverNowMs": 50000,
      "clockReady": true,
      "currentTime": 100,
      "paused": true,
      "isHost": false,
      "mode": "hopping",
      "userSeeking": false,
      "suppressHardSeek": false,
      "correctionState": null,
      "expect": { "seekTo": null, "rate": 1, "play": false, "pause": false, "hardSeek": false, "pausedSeek": false, "drift": null }
    },
    {
      "name": "an untrusted clock suppresses every playing-phase correction",
      "schedule": { "positionTicks": 500000000, "t0": 1000, "rate": 1, "paused": false, "phase": "playing", "version": 3, "mediaGeneration": 1 },
      "serverNowMs": 3000,
      "clockReady": false,
      "currentTime": 10,
      "paused": false,
      "isHost": false,
      "mode": "hopping",
      "userSeeking": false,
      "suppressHardSeek": false,
      "correctionState": null,
      "expect": null
    },
    {
      "name": "a predicted position before the start of the media is not actionable",
      "schedule": { "positionTicks": 0, "t0": 10000, "rate": 1, "paused": false, "phase": "playing", "version": 3, "mediaGeneration": 1 },
      "serverNowMs": 5000,
      "clockReady": true,
      "currentTime": 0,
      "paused": false,
      "isHost": false,
      "mode": "hopping",
      "userSeeking": false,
      "suppressHardSeek": false,
      "correctionState": null,
      "expect": null
    },
    {
      "name": "a paused member resumes onto the live position",
      "schedule": { "positionTicks": 500000000, "t0": 1000, "rate": 1, "paused": false, "phase": "playing", "version": 3, "mediaGeneration": 1 },
      "serverNowMs": 3000,
      "clockReady": true,
      "currentTime": 51.8,
      "paused": true,
      "isHost": false,
      "mode": "hopping",
      "userSeeking": false,
      "suppressHardSeek": false,
      "correctionState": null,
      "expect": { "seekTo": 52, "rate": 1, "play": true, "pause": false, "hardSeek": false, "pausedSeek": false, "drift": 0.2 }
    },
    {
      "name": "a late-joining hopping guest resumes through the buffered rendezvous",
      "schedule": { "positionTicks": 500000000, "t0": 1000, "rate": 1, "paused": false, "phase": "playing", "version": 3, "mediaGeneration": 1 },
      "serverNowMs": 3000,
      "clockReady": true,
      "currentTime": 40,
      "paused": true,
      "isHost": false,
      "mode": "hopping",
      "userSeeking": false,
      "suppressHardSeek": false,
      "correctionState": null,
      "expect": { "seekTo": 52, "rate": 1, "play": true, "pause": false, "hardSeek": true, "pausedSeek": false, "drift": 12 }
    },
    {
      "name": "a paused dragging host resumes without the buffered rendezvous",
      "schedule": { "positionTicks": 500000000, "t0": 1000, "rate": 1, "paused": false, "phase": "playing", "version": 3, "mediaGeneration": 1 },
      "serverNowMs": 3000,
      "clockReady": true,
      "currentTime": 40,
      "paused": true,
      "isHost": true,
      "mode": "dragging",
      "userSeeking": false,
      "suppressHardSeek": false,
      "correctionState": null,
      "expect": { "seekTo": 52, "rate": 1, "play": true, "pause": false, "hardSeek": false, "pausedSeek": false, "drift": 12 }
    },
    {
      "name": "a dragging host ignores routine jitter",
      "schedule": { "positionTicks": 500000000, "t0": 1000, "rate": 1, "paused": false, "phase": "playing", "version": 3, "mediaGeneration": 1 },
      "serverNowMs": 3000,
      "clockReady": true,
      "currentTime": 51,
      "paused": false,
      "isHost": true,
      "mode": "dragging",
      "userSeeking": false,
      "suppressHardSeek": false,
      "correctionState": null,
      "expect": { "seekTo": null, "rate": 1, "play": false, "pause": false, "hardSeek": false, "pausedSeek": false, "drift": 1 }
    },
    {
      "name": "a dragging host past HOST_DRAG_SEEK_SEC corrects with a plain seek, never a nudge",
      "schedule": { "positionTicks": 500000000, "t0": 1000, "rate": 1, "paused": false, "phase": "playing", "version": 3, "mediaGeneration": 1 },
      "serverNowMs": 3000,
      "clockReady": true,
      "currentTime": 49,
      "paused": false,
      "isHost": true,
      "mode": "dragging",
      "userSeeking": false,
      "suppressHardSeek": false,
      "correctionState": null,
      "expect": { "seekTo": 52, "rate": 1, "play": false, "pause": false, "hardSeek": false, "pausedSeek": false, "drift": 3 }
    },
    {
      "name": "guest drift past HARD_SEEK_SEC jumps to live",
      "schedule": { "positionTicks": 500000000, "t0": 1000, "rate": 1, "paused": false, "phase": "playing", "version": 3, "mediaGeneration": 1 },
      "serverNowMs": 3000,
      "clockReady": true,
      "currentTime": 50.5,
      "paused": false,
      "isHost": false,
      "mode": "hopping",
      "userSeeking": false,
      "suppressHardSeek": false,
      "correctionState": null,
      "expect": { "seekTo": 52, "rate": 1, "play": false, "pause": false, "hardSeek": true, "pausedSeek": false, "drift": 1.5 }
    },
    {
      "name": "the hard-seek cooldown downgrades a gross correction to a clamped nudge",
      "schedule": { "positionTicks": 500000000, "t0": 1000, "rate": 1, "paused": false, "phase": "playing", "version": 3, "mediaGeneration": 1 },
      "serverNowMs": 3000,
      "clockReady": true,
      "currentTime": 50.5,
      "paused": false,
      "isHost": false,
      "mode": "hopping",
      "userSeeking": false,
      "suppressHardSeek": true,
      "correctionState": null,
      "expect": { "seekTo": null, "rate": 1.08, "play": false, "pause": false, "hardSeek": false, "pausedSeek": false, "drift": 1.5 }
    },
    {
      "name": "drift inside the soft band is closed with a bounded rate nudge",
      "schedule": { "positionTicks": 500000000, "t0": 1000, "rate": 1, "paused": false, "phase": "playing", "version": 3, "mediaGeneration": 1 },
      "serverNowMs": 3000,
      "clockReady": true,
      "currentTime": 51.7,
      "paused": false,
      "isHost": false,
      "mode": "hopping",
      "userSeeking": false,
      "suppressHardSeek": false,
      "correctionState": null,
      "expect": { "seekTo": null, "rate": 1.036, "play": false, "pause": false, "hardSeek": false, "pausedSeek": false, "drift": 0.3 }
    },
    {
      "name": "a guest running ahead is nudged slower",
      "schedule": { "positionTicks": 500000000, "t0": 1000, "rate": 1, "paused": false, "phase": "playing", "version": 3, "mediaGeneration": 1 },
      "serverNowMs": 3000,
      "clockReady": true,
      "currentTime": 52.3,
      "paused": false,
      "isHost": false,
      "mode": "hopping",
      "userSeeking": false,
      "suppressHardSeek": false,
      "correctionState": null,
      "expect": { "seekTo": null, "rate": 0.964, "play": false, "pause": false, "hardSeek": false, "pausedSeek": false, "drift": -0.3 }
    },
    {
      "name": "the downward nudge is clamped at MAX_RATE_ADJ too",
      "schedule": { "positionTicks": 500000000, "t0": 1000, "rate": 1, "paused": false, "phase": "playing", "version": 3, "mediaGeneration": 1 },
      "serverNowMs": 3000,
      "clockReady": true,
      "currentTime": 54,
      "paused": false,
      "isHost": false,
      "mode": "hopping",
      "userSeeking": false,
      "suppressHardSeek": true,
      "correctionState": null,
      "expect": { "seekTo": null, "rate": 0.92, "play": false, "pause": false, "hardSeek": false, "pausedSeek": false, "drift": -2 }
    },
    {
      "name": "drift under SOFT_SEC leaves the rate alone",
      "schedule": { "positionTicks": 500000000, "t0": 1000, "rate": 1, "paused": false, "phase": "playing", "version": 3, "mediaGeneration": 1 },
      "serverNowMs": 3000,
      "clockReady": true,
      "currentTime": 51.95,
      "paused": false,
      "isHost": false,
      "mode": "hopping",
      "userSeeking": false,
      "suppressHardSeek": false,
      "correctionState": null,
      "expect": { "seekTo": null, "rate": 1, "play": false, "pause": false, "hardSeek": false, "pausedSeek": false, "drift": 0.05 }
    },
    {
      "name": "entering the soft band arms the hysteresis latch",
      "schedule": { "positionTicks": 500000000, "t0": 1000, "rate": 1, "paused": false, "phase": "playing", "version": 3, "mediaGeneration": 1 },
      "serverNowMs": 3000,
      "clockReady": true,
      "currentTime": 51.7,
      "paused": false,
      "isHost": false,
      "mode": "hopping",
      "userSeeking": false,
      "suppressHardSeek": false,
      "correctionState": { "correcting": false },
      "expect": { "seekTo": null, "rate": 1.036, "play": false, "pause": false, "hardSeek": false, "pausedSeek": false, "drift": 0.3 },
      "expectCorrectionState": { "correcting": true }
    },
    {
      "name": "a latched nudge keeps correcting between SOFT_EXIT_SEC and SOFT_SEC",
      "schedule": { "positionTicks": 500000000, "t0": 1000, "rate": 1, "paused": false, "phase": "playing", "version": 3, "mediaGeneration": 1 },
      "serverNowMs": 3000,
      "clockReady": true,
      "currentTime": 51.95,
      "paused": false,
      "isHost": false,
      "mode": "hopping",
      "userSeeking": false,
      "suppressHardSeek": false,
      "correctionState": { "correcting": true },
      "expect": { "seekTo": null, "rate": 1.006, "play": false, "pause": false, "hardSeek": false, "pausedSeek": false, "drift": 0.05 },
      "expectCorrectionState": { "correcting": true }
    },
    {
      "name": "a latched nudge releases under SOFT_EXIT_SEC",
      "schedule": { "positionTicks": 500000000, "t0": 1000, "rate": 1, "paused": false, "phase": "playing", "version": 3, "mediaGeneration": 1 },
      "serverNowMs": 3000,
      "clockReady": true,
      "currentTime": 51.98,
      "paused": false,
      "isHost": false,
      "mode": "hopping",
      "userSeeking": false,
      "suppressHardSeek": false,
      "correctionState": { "correcting": true },
      "expect": { "seekTo": null, "rate": 1, "play": false, "pause": false, "hardSeek": false, "pausedSeek": false, "drift": 0.02 },
      "expectCorrectionState": { "correcting": false }
    },
    {
      "name": "a hard seek disarms the hysteresis latch",
      "schedule": { "positionTicks": 500000000, "t0": 1000, "rate": 1, "paused": false, "phase": "playing", "version": 3, "mediaGeneration": 1 },
      "serverNowMs": 3000,
      "clockReady": true,
      "currentTime": 50.5,
      "paused": false,
      "isHost": false,
      "mode": "hopping",
      "userSeeking": false,
      "suppressHardSeek": false,
      "correctionState": { "correcting": true },
      "expect": { "seekTo": 52, "rate": 1, "play": false, "pause": false, "hardSeek": true, "pausedSeek": false, "drift": 1.5 },
      "expectCorrectionState": { "correcting": false }
    }
  ]
}
