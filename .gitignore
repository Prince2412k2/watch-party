node_modules/
.env
.env.local
# livekit.yaml holds the real LiveKit API key:secret — keep it out of git.
# Commit livekit.yaml.example (placeholders) instead. It was tracked with a
# placeholder devkey/devsecret in early commits and untracked in a8a09bf — see
# docs/security/livekit-credential-exposure.md.
livekit.yaml
.claude/
jellyfin/config/
media/
*.log
dist/
.DS_Store

# servarr deploy (contains no real secrets, but ignored for hygiene)
.env.servarr
servarr-config/
media-data/

# persistent session stores and runtime databases (private, generated data)
/data/
/app/data/
/app/server/data/

# VPN / WireGuard / OpenVPN configs — contain private keys, never commit
*.conf
*.ovpn
wg-*.conf
*.pem
*.key

# Production secrets for the VPS deploy (env files, livekit.yaml, coturn.conf,
# Caddyfile) — never commit.
secrets/

# Subagent working copies — never commit
.pi-subagents/
